# ============================================================
# Copy file này thành .env rồi đổi giá trị:   cp .env.example .env
# File .env đã nằm trong .gitignore => KHÔNG BAO GIỜ commit secret (CON-09, NFR-SEC-003).
# Cả docker compose lẫn các service Spring Boot đều đọc file .env này.
# ============================================================

# --- PostgreSQL (superuser, chỉ dùng cho container) ---
# Cổng Postgres trên máy. 5433 để không trùng Postgres của project khác đang giữ 5432
DB_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_root

# --- Mỗi service một DB user riêng ---
IDENTITY_DB_PASSWORD=change_me_identity
CATALOG_DB_PASSWORD=change_me_catalog
ORDER_DB_PASSWORD=change_me_order
PAYMENT_DB_PASSWORD=change_me_payment
NOTIFICATION_DB_PASSWORD=change_me_notification

# --- Cổng trên máy cho hạ tầng docker. Đổi khỏi mặc định để không đụng project khác đang chạy ---
REDIS_PORT=6380
RABBITMQ_PORT=5673
RABBITMQ_UI_PORT=15673
MAIL_PORT=1026
MAILPIT_UI_PORT=8026

# --- Redis ---
REDIS_PASSWORD=change_me_redis

# --- RabbitMQ ---
RABBITMQ_USER=ecommerce
RABBITMQ_PASSWORD=change_me_rabbit

# ============================================================
# Các giá trị dưới đây do scripts/gen-secrets.sh tự sinh. Chạy:  scripts/gen-secrets.sh
# ============================================================

# --- JWT: cặp khóa RSA (identity ký, các service khác verify qua JWKS) ---
JWT_PRIVATE_KEY_PATH=secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=secrets/jwt-public.pem

# --- Khóa AES-256 (base64, 32 byte) mã hóa token nhạy cảm trong event (identity -> notification) ---
EVENT_PAYLOAD_KEY=

# --- Tài khoản ADMIN đầu tiên, tạo lúc identity khởi động nếu chưa có ---
ADMIN_EMAIL=admin@ecommerce.local
ADMIN_PASSWORD=

# --- Bật bắt buộc xác minh email trước khi đăng nhập (FR-IAM-004) ---
EMAIL_VERIFICATION_REQUIRED=false

# --- Payment: khóa HMAC ký/verify webhook của mock provider (FR-PAY-007) ---
PAYMENT_WEBHOOK_SECRET=

# --- HTTPS ở gateway (CON-03). Bật: GATEWAY_SSL_ENABLED=true rồi gọi https://localhost:8443 ---
# Cổng gateway (mặc định 8080)
GATEWAY_PORT=8080
GATEWAY_SSL_ENABLED=false
GATEWAY_KEYSTORE_PASSWORD=

# --- CORS: danh sách origin được phép gọi API (FR-GW-008), phân cách bằng dấu phẩy ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Link trong email trỏ về frontend ---
FRONTEND_BASE_URL=http://localhost:5173
# URL công khai của gateway, dùng để dựng link thanh toán
PUBLIC_BASE_URL=http://localhost:8080
